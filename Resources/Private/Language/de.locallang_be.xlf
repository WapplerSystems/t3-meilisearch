<?xml version="1.0" encoding="UTF-8"?>
<xliff version="1.2" xmlns="urn:oasis:names:tc:xliff:document:1.2">
    <file source-language="en" target-language="de" datatype="plaintext" original="messages" date="2026-06-26T00:00:00Z" product-name="ws_meilisearch">
        <header/>
        <body>
            <trans-unit id="plugin.search.title">
                <source>Meilisearch: Search Plugin</source>
                <target>Meilisearch: Such-Plugin</target>
            </trans-unit>
            <trans-unit id="plugin.search.description">
                <source>Faceted full-text search backed by Meilisearch.</source>
                <target>Facettierte Volltextsuche auf Basis von Meilisearch.</target>
            </trans-unit>
            <trans-unit id="plugin.rag.title">
                <source>Meilisearch: RAG (ask the site)</source>
                <target>Meilisearch: RAG (Seite fragen)</target>
            </trans-unit>
            <trans-unit id="plugin.rag.description">
                <source>Retrieval-Augmented Generation: search the site index and ask an LLM to summarize the matching documents.</source>
                <target>Retrieval-Augmented Generation: durchsucht den Seitenindex und lässt ein LLM die passenden Dokumente zusammenfassen.</target>
            </trans-unit>
            <trans-unit id="task.fullReindex.title">
                <source>Meilisearch: Full Reindex</source>
                <target>Meilisearch: Voll-Reindex</target>
            </trans-unit>
            <trans-unit id="task.fullReindex.description">
                <source>Iterates all sites (or a single site) and re-pushes every indexed record to Meilisearch.</source>
                <target>Durchläuft alle Sites (oder eine einzelne) und schreibt jeden indexierten Datensatz erneut an Meilisearch.</target>
            </trans-unit>
            <trans-unit id="task.fullReindex.site_identifier">
                <source>Site identifier</source>
                <target>Site-Identifier</target>
            </trans-unit>
            <trans-unit id="task.fullReindex.site_identifier.description">
                <source>Empty = all sites. Otherwise the TYPO3 site identifier (matches the directory under config/sites/).</source>
                <target>Leer = alle Sites. Andernfalls der TYPO3-Site-Identifier (entspricht dem Verzeichnis unter config/sites/).</target>
            </trans-unit>
            <trans-unit id="task.fullReindex.rebuild">
                <source>Rebuild</source>
                <target>Neu aufbauen</target>
            </trans-unit>
            <trans-unit id="task.fullReindex.rebuild.description">
                <source>Drop and recreate the Meilisearch index before populating. Use only after schema changes — the index is unavailable for the duration.</source>
                <target>Verwirft den Meilisearch-Index vor dem Befüllen und legt ihn neu an. Nur nach Schema-Änderungen verwenden — der Index ist währenddessen nicht verfügbar.</target>
            </trans-unit>
            <trans-unit id="task.fullReindex.skip_embedder">
                <source>Skip embedder push</source>
                <target>Embedder-Push überspringen</target>
            </trans-unit>
            <trans-unit id="task.fullReindex.skip_embedder.description">
                <source>Leave the configured embedder settings untouched on Meilisearch. Use when troubleshooting a wedged hybrid setup.</source>
                <target>Lässt die konfigurierten Embedder-Einstellungen auf Meilisearch unangetastet. Zur Fehlersuche bei festgefahrenem Hybrid-Setup.</target>
            </trans-unit>
            <trans-unit id="module.overview.title">
                <source>Meilisearch</source>
                <target>Meilisearch</target>
            </trans-unit>
            <trans-unit id="module.overview.description">
                <source>Index status and ad-hoc search / RAG testing.</source>
                <target>Index-Status und Ad-hoc-Suche / RAG-Test.</target>
            </trans-unit>
            <trans-unit id="module.action.reindex">
                <source>Reindex</source>
                <target>Reindex</target>
            </trans-unit>
            <trans-unit id="module.action.rebuild">
                <source>Rebuild</source>
                <target>Neu aufbauen</target>
            </trans-unit>
            <trans-unit id="module.action.test_search">
                <source>Test search</source>
                <target>Suche testen</target>
            </trans-unit>
            <trans-unit id="module.action.test_ask">
                <source>Test RAG</source>
                <target>RAG testen</target>
            </trans-unit>
            <trans-unit id="module.flash.reindex_done">
                <source>Reindexed %d document(s) for site "%s".</source>
                <target>%d Dokument(e) für Site „%s“ neu indexiert.</target>
            </trans-unit>
            <trans-unit id="module.flash.reindex_skipped">
                <source>Site "%s" is not configured for Meilisearch.</source>
                <target>Site „%s“ ist nicht für Meilisearch konfiguriert.</target>
            </trans-unit>
            <trans-unit id="tca.boost.tab">
                <source>Search</source>
                <target>Suche</target>
            </trans-unit>
            <trans-unit id="tca.boost.label">
                <source>Search ranking boost</source>
                <target>Such-Ranking-Gewichtung</target>
            </trans-unit>
            <trans-unit id="tca.boost.description">
                <source>Promotes or demotes this record in search results. Composes multiplicatively with the per-type default configured in Site Settings. Has no effect unless the integrator has enabled the boost ranking rule.</source>
                <target>Stuft diesen Datensatz in den Suchergebnissen höher oder niedriger ein. Wirkt multiplikativ mit dem pro Datensatztyp konfigurierten Standardwert (Site Settings). Greift nur, wenn die Boost-Ranking-Regel aktiviert ist.</target>
            </trans-unit>
            <trans-unit id="tca.boost.veryLow">
                <source>Very low (0.5×)</source>
                <target>Sehr niedrig (0,5×)</target>
            </trans-unit>
            <trans-unit id="tca.boost.low">
                <source>Low (0.75×)</source>
                <target>Niedrig (0,75×)</target>
            </trans-unit>
            <trans-unit id="tca.boost.normal">
                <source>Normal (1×) — default</source>
                <target>Normal (1×) — Standard</target>
            </trans-unit>
            <trans-unit id="tca.boost.high">
                <source>High (1.5×)</source>
                <target>Hoch (1,5×)</target>
            </trans-unit>
            <trans-unit id="tca.boost.veryHigh">
                <source>Very high (2×)</source>
                <target>Sehr hoch (2×)</target>
            </trans-unit>
            <trans-unit id="dictionary.title">
                <source>Search dictionary</source>
                <target>Suchwörterbuch</target>
            </trans-unit>
            <trans-unit id="dictionary.kind">
                <source>Type</source>
                <target>Art</target>
            </trans-unit>
            <trans-unit id="dictionary.kind.description">
                <source>Synonym = the term expands to the words on the right. Single token = never split this character sequence (product keys, parameter names). Stop word = ignore the word while indexing and searching.</source>
                <target>Synonym = der Begriff wird um die Wörter rechts erweitert. Ein Token = diese Zeichenfolge nie zerlegen (Typenschlüssel, Parameternamen). Stoppwort = Wort beim Indexieren und Suchen ignorieren.</target>
            </trans-unit>
            <trans-unit id="dictionary.kind.synonym">
                <source>Synonym</source>
                <target>Synonym</target>
            </trans-unit>
            <trans-unit id="dictionary.kind.word">
                <source>Single token</source>
                <target>Ein Token</target>
            </trans-unit>
            <trans-unit id="dictionary.kind.stopword">
                <source>Stop word</source>
                <target>Stoppwort</target>
            </trans-unit>
            <trans-unit id="dictionary.term">
                <source>Term</source>
                <target>Begriff</target>
            </trans-unit>
            <trans-unit id="dictionary.term.description">
                <source>What visitors type. Lowercase; matching is case-insensitive.</source>
                <target>Was Besucher eintippen. Kleinschreibung, die Zuordnung erfolgt unabhängig von Groß- und Kleinschreibung.</target>
            </trans-unit>
            <trans-unit id="dictionary.replacements">
                <source>Expands to</source>
                <target>Erweitert um</target>
            </trans-unit>
            <trans-unit id="dictionary.replacements.description">
                <source>One word or phrase per line. A search for the term above also matches documents containing these. Add the reverse direction as its own record if it should work both ways.</source>
                <target>Ein Wort oder eine Wortgruppe pro Zeile. Eine Suche nach dem Begriff oben findet dann auch Dokumente, die diese enthalten. Soll es in beide Richtungen gelten, dafür einen eigenen Datensatz anlegen.</target>
            </trans-unit>
            <trans-unit id="dictionary.state">
                <source>Status</source>
                <target>Status</target>
            </trans-unit>
            <trans-unit id="dictionary.state.description">
                <source>Only "active" records are pushed to the search engine. "Candidate" is a machine proposal waiting for review, "rejected" keeps it from being proposed again.</source>
                <target>Nur „aktiv" wird an die Suchmaschine übertragen. „Kandidat" ist ein maschineller Vorschlag zur Prüfung, „abgelehnt" verhindert, dass er erneut vorgeschlagen wird.</target>
            </trans-unit>
            <trans-unit id="dictionary.state.candidate">
                <source>Candidate (not in use)</source>
                <target>Kandidat (nicht in Benutzung)</target>
            </trans-unit>
            <trans-unit id="dictionary.state.active">
                <source>Active</source>
                <target>Aktiv</target>
            </trans-unit>
            <trans-unit id="dictionary.state.rejected">
                <source>Rejected</source>
                <target>Abgelehnt</target>
            </trans-unit>
            <trans-unit id="dictionary.site">
                <source>Site</source>
                <target>Site</target>
            </trans-unit>
            <trans-unit id="dictionary.site.description">
                <source>Leave empty to apply to every site of this installation.</source>
                <target>Leer lassen, damit der Eintrag für alle Sites dieser Installation gilt.</target>
            </trans-unit>
            <trans-unit id="dictionary.source">
                <source>Origin</source>
                <target>Herkunft</target>
            </trans-unit>
            <trans-unit id="dictionary.source.manual">
                <source>Entered manually</source>
                <target>Manuell eingetragen</target>
            </trans-unit>
            <trans-unit id="dictionary.source.log">
                <source>Mined from the search log</source>
                <target>Aus dem Suchprotokoll gewonnen</target>
            </trans-unit>
            <trans-unit id="dictionary.source.translation">
                <source>Mined from translated titles</source>
                <target>Aus übersetzten Titeln gewonnen</target>
            </trans-unit>
            <trans-unit id="dictionary.source.vocabulary">
                <source>Mined from the index vocabulary</source>
                <target>Aus dem Index-Vokabular gewonnen</target>
            </trans-unit>
            <trans-unit id="dictionary.evidence">
                <source>Evidence</source>
                <target>Belege</target>
            </trans-unit>
            <trans-unit id="dictionary.hits">
                <source>Hits of the proposal</source>
                <target>Treffer des Vorschlags</target>
            </trans-unit>
            <trans-unit id="dictionary.tab.origin">
                <source>Origin</source>
                <target>Herkunft</target>
            </trans-unit>
            <trans-unit id="module.knowledge.title" resname="module.knowledge.title">
                <source>Chatbot knowledge</source>
                <target>Chatbot-Wissen</target>
            </trans-unit>
            <trans-unit id="module.knowledge.description" resname="module.knowledge.description">
                <source>Hand-written knowledge the chat assistant answers from</source>
                <target>Eigenes Wissen, aus dem der Chat-Assistent antwortet</target>
            </trans-unit>
            <trans-unit id="knowledgeEntry.table" resname="knowledgeEntry.table">
                <source>Chatbot knowledge entry</source>
                <target>Chatbot-Wissenseintrag</target>
            </trans-unit>
            <trans-unit id="knowledgeEntry.tab.content" resname="knowledgeEntry.tab.content">
                <source>Content</source>
                <target>Inhalt</target>
            </trans-unit>
            <trans-unit id="knowledgeEntry.tab.access" resname="knowledgeEntry.tab.access">
                <source>Validity &amp; weighting</source>
                <target>Gültigkeit &amp; Gewichtung</target>
            </trans-unit>
            <trans-unit id="knowledgeEntry.tab.internal" resname="knowledgeEntry.tab.internal">
                <source>Internal</source>
                <target>Intern</target>
            </trans-unit>
            <trans-unit id="knowledgeEntry.sys_language_uid" resname="knowledgeEntry.sys_language_uid">
                <source>Language</source>
                <target>Sprache</target>
            </trans-unit>
            <trans-unit id="knowledgeEntry.l10n_parent" resname="knowledgeEntry.l10n_parent">
                <source>Translation of</source>
                <target>Übersetzung von</target>
            </trans-unit>
            <trans-unit id="knowledgeEntry.hidden" resname="knowledgeEntry.hidden">
                <source>Hidden</source>
                <target>Ausgeblendet</target>
            </trans-unit>
            <trans-unit id="knowledgeEntry.starttime" resname="knowledgeEntry.starttime">
                <source>Valid from</source>
                <target>Gültig ab</target>
            </trans-unit>
            <trans-unit id="knowledgeEntry.endtime" resname="knowledgeEntry.endtime">
                <source>Valid until</source>
                <target>Gültig bis</target>
            </trans-unit>
            <trans-unit id="knowledgeEntry.title" resname="knowledgeEntry.title">
                <source>Topic or question</source>
                <target>Thema oder Frage</target>
            </trans-unit>
            <trans-unit id="knowledgeEntry.title.description" resname="knowledgeEntry.title.description">
                <source>What the entry is about, phrased the way a customer would ask, e.g. "Which operating systems are supported?"</source>
                <target>Worum es geht, so formuliert, wie Kunden fragen, z. B. „Welche Betriebssysteme werden unterstützt?“</target>
            </trans-unit>
            <trans-unit id="knowledgeEntry.body" resname="knowledgeEntry.body">
                <source>Information</source>
                <target>Information</target>
            </trans-unit>
            <trans-unit id="knowledgeEntry.body.description" resname="knowledgeEntry.body.description">
                <source>The information itself, in complete sentences. The assistant reads exactly this text — write it as you would explain it to a customer. One topic per entry.</source>
                <target>Die Information selbst, in ganzen Sätzen. Der Assistent liest genau diesen Text – schreiben Sie ihn so, wie Sie es einem Kunden erklären würden. Ein Thema pro Eintrag.</target>
            </trans-unit>
            <trans-unit id="knowledgeEntry.keywords" resname="knowledgeEntry.keywords">
                <source>Alternative wordings</source>
                <target>Andere Formulierungen</target>
            </trans-unit>
            <trans-unit id="knowledgeEntry.keywords.description" resname="knowledgeEntry.keywords.description">
                <source>Synonyms and wordings customers use, comma-separated, so the entry is found even when the question uses different words.</source>
                <target>Synonyme und Formulierungen, die Kunden verwenden, durch Komma getrennt – damit der Eintrag auch bei anders formulierten Fragen gefunden wird.</target>
            </trans-unit>
            <trans-unit id="knowledgeEntry.notes" resname="knowledgeEntry.notes">
                <source>Internal note</source>
                <target>Interne Notiz</target>
            </trans-unit>
            <trans-unit id="knowledgeEntry.notes.description" resname="knowledgeEntry.notes.description">
                <source>Why the entry exists, who confirmed it. Never shown to the assistant.</source>
                <target>Warum es den Eintrag gibt, wer ihn bestätigt hat. Wird dem Assistenten nie gezeigt.</target>
            </trans-unit>
            <trans-unit id="knowledgeEntry.source_conversation" resname="knowledgeEntry.source_conversation">
                <source>From chat conversation</source>
                <target>Aus Chat-Gespräch</target>
            </trans-unit>
            <trans-unit id="knowledgeEntry.source_conversation.description" resname="knowledgeEntry.source_conversation.description">
                <source>Chat conversation this entry was written for (see the chat protocol).</source>
                <target>Chat-Gespräch, für das dieser Eintrag angelegt wurde (siehe Chat-Protokoll).</target>
            </trans-unit>
            <trans-unit id="knowledgeEntry.tx_wsmeilisearch_boost" resname="knowledgeEntry.tx_wsmeilisearch_boost">
                <source>Weighting</source>
                <target>Gewichtung</target>
            </trans-unit>
            <trans-unit id="knowledgeEntry.tx_wsmeilisearch_boost.description" resname="knowledgeEntry.tx_wsmeilisearch_boost.description">
                <source>Keep it high so hand-written knowledge wins over imported documentation on the same topic.</source>
                <target>Hoch lassen, damit eigenes Wissen bei gleichem Thema vor der importierten Dokumentation steht.</target>
            </trans-unit>
        </body>
    </file>
