                <source>Semantic search</source>
                <target>Wyszukiwanie semantyczne</target>
            </trans-unit>
            <trans-unit id="search.hybrid.help">
                <source>Combine keyword and vector matching for fuzzy-meaning queries.</source>
                <target>Łączy wyszukiwanie według słów kluczowych i wektorowe, aby znajdować wyniki według znaczenia, a nie dokładnego brzmienia.</target>
            </trans-unit>
