<?xml version="1.0" encoding="UTF-8"?>
<xliff version="1.2" xmlns="urn:oasis:names:tc:xliff:document:1.2">
    <file source-language="en" target-language="ru" datatype="plaintext" original="messages" date="2026-11-06T00:00:00Z" product-name="ws_meilisearch">
        <header/>
        <body>
            <trans-unit id="search.form.placeholder">
                <source>Search…</source>
                <target>Поиск…</target>
            </trans-unit>
            <trans-unit id="search.form.submit">
                <source>Search</source>
                <target>Найти</target>
            </trans-unit>
            <trans-unit id="search.form.placeholder.scoped">
                <source>Search in %s…</source>
                <target>Поиск в разделе %s…</target>
            </trans-unit>
            <trans-unit id="search.scope.label">
                <source>Scope: %s</source>
                <target>Область: %s</target>
            </trans-unit>
            <trans-unit id="search.scope.clear">
                <source>Remove filter</source>
                <target>Сбросить фильтр</target>
            </trans-unit>
            <trans-unit id="search.results.empty">
                <source>No matches for "%s".</source>
                <target>По запросу «%s» ничего не найдено.</target>
            </trans-unit>
            <trans-unit id="search.results.count">
                <source>%d results for "%s"</source>
                <target>Найдено результатов: %d (запрос «%s»)</target>
            </trans-unit>
            <trans-unit id="search.facets.heading">
                <source>Filter</source>
                <target>Фильтр</target>
            </trans-unit>
            <trans-unit id="rag.form.heading">
                <source>Ask the site</source>
                <target>Вопрос к сайту</target>
            </trans-unit>
            <trans-unit id="rag.form.placeholder">
                <source>Type your question…</source>
                <target>Введите Ваш вопрос…</target>
            </trans-unit>
            <trans-unit id="rag.form.submit">
                <source>Ask</source>
                <target>Спросить</target>
            </trans-unit>
            <trans-unit id="rag.form.loading">
                <source>Generating answer…</source>
                <target>Ответ формируется…</target>
            </trans-unit>
            <trans-unit id="rag.form.reset">
                <source>Start over</source>
                <target>Начать заново</target>
            </trans-unit>
            <trans-unit id="rag.answer.heading">
                <source>Answer</source>
                <target>Ответ</target>
            </trans-unit>
            <trans-unit id="rag.answer.sources">
                <source>Sources</source>
                <target>Источники</target>
            </trans-unit>
            <trans-unit id="rag.answer.loading">
                <source>Generating answer…</source>
                <target>Ответ формируется…</target>
            </trans-unit>
            <trans-unit id="rag.answer.interrupted">
                <source>Connection to the server was interrupted.</source>
                <target>Соединение с сервером прервано.</target>
            </trans-unit>
            <trans-unit id="rag.suggestions.heading">
                <source>Suggestions</source>
                <target>Предложения</target>
            </trans-unit>
            <trans-unit id="rag.answer.lowConfidence">
                <source>&lt;strong&gt;Heads up:&lt;/strong&gt; the assistant didn't cite any of the retrieved documents — the answer above may not be directly grounded in the indexed content. Try rephrasing with more specific terms.</source>
                <target>&lt;strong&gt;Внимание:&lt;/strong&gt; ассистент не сослался ни на один из найденных документов — ответ выше может не основываться непосредственно на проиндексированном содержимом. Попробуйте переформулировать вопрос, используя более точные термины.</target>
            </trans-unit>
            <trans-unit id="rag.status.disabled">
                <source>The site assistant is not configured.</source>
                <target>Ассистент сайта не настроен.</target>
            </trans-unit>
            <trans-unit id="rag.status.no_context">
                <source>No matching documents found for this question.</source>
                <target>По этому вопросу не найдено подходящих документов.</target>
            </trans-unit>
            <trans-unit id="rag.status.failed">
                <source>Sorry, something went wrong: %s</source>
                <target>К сожалению, произошла ошибка: %s</target>
            </trans-unit>
            <trans-unit id="rag.status.clarify.heading">
                <source>One quick question</source>
                <target>Уточняющий вопрос</target>
            </trans-unit>
            <trans-unit id="rag.conversation.you">
                <source>You</source>
                <target>Вы</target>
            </trans-unit>
            <trans-unit id="rag.conversation.assistant">
                <source>Assistant</source>
                <target>Ассистент</target>
            </trans-unit>
            <trans-unit id="rag.fallback.heading">
                <source>Still have questions?</source>
                <target>Остались вопросы?</target>
            </trans-unit>
            <trans-unit id="rag.fallback.intro">
                <source>If your question wasn't answered, reach a human:</source>
                <target>Если Вы не получили ответа на свой вопрос, свяжитесь с нами напрямую:</target>
            </trans-unit>
            <trans-unit id="rag.fallback.email">
                <source>Email</source>
                <target>Эл. почта</target>
            </trans-unit>
            <trans-unit id="rag.fallback.email.subject">
                <source>Question from the website chat</source>
                <target>Вопрос из чата на сайте</target>
            </trans-unit>
            <trans-unit id="rag.fallback.phone">
                <source>Phone</source>
                <target>Телефон</target>
            </trans-unit>
            <trans-unit id="rag.fallback.ticket">
                <source>Open a ticket</source>
                <target>Создать заявку</target>
            </trans-unit>
            <trans-unit id="suggest.recent.heading">
                <source>Recent searches</source>
                <target>Недавние запросы</target>
            </trans-unit>
            <trans-unit id="suggest.more">
                <source>%d more — submit to see all</source>
                <target>Ещё %d — отправьте запрос, чтобы увидеть все</target>
            </trans-unit>
            <trans-unit id="hit.language">
                <source>Language</source>
                <target>Язык</target>
            </trans-unit>
            <trans-unit id="facet.attr.type">
                <source>Type</source>
                <target>Тип</target>
            </trans-unit>
            <trans-unit id="facet.attr.language">
                <source>Language</source>
                <target>Язык</target>
            </trans-unit>
            <trans-unit id="facet.value.type.page">
                <source>Page</source>
                <target>Страница</target>
            </trans-unit>
            <trans-unit id="facet.value.type.news">
                <source>News</source>
                <target>Новости</target>
            </trans-unit>
            <trans-unit id="facet.value.type.file">
                <source>File</source>
                <target>Файл</target>
            </trans-unit>
            <trans-unit id="facet.value.type.event">
                <source>Event</source>
                <target>Мероприятие</target>
            </trans-unit>
            <trans-unit id="facet.value.type.tt_content">
                <source>Content element</source>
                <target>Элемент контента</target>
            </trans-unit>
            <trans-unit id="facet.value.type.knowledge_resource">
                <source>Knowledge resource</source>
                <target>Источник знаний</target>
            </trans-unit>
            <trans-unit id="search.sort.label">
                <source>Sort by</source>
                <target>Сортировка</target>
            </trans-unit>
            <trans-unit id="search.sort.relevance">
                <source>Relevance</source>
                <target>По релевантности</target>
            </trans-unit>
            <trans-unit id="search.sort.datetime.desc">
                <source>Newest first</source>
                <target>Сначала новые</target>
            </trans-unit>
            <trans-unit id="search.sort.datetime.asc">
                <source>Oldest first</source>
                <target>Сначала старые</target>
            </trans-unit>
            <trans-unit id="search.sort.fileSize.desc">
                <source>Largest file first</source>
                <target>Сначала большие файлы</target>
            </trans-unit>
            <trans-unit id="search.sort.fileSize.asc">
                <source>Smallest file first</source>
                <target>Сначала маленькие файлы</target>
            </trans-unit>
            <trans-unit id="search.hybrid.label">
                <source>Semantic search</source>
                <target>Семантический поиск</target>
            </trans-unit>
            <trans-unit id="search.hybrid.help">
                <source>Combine keyword and vector matching for fuzzy-meaning queries.</source>
                <target>Сочетает поиск по ключевым словам и векторный поиск, чтобы находить результаты по смыслу, а не по точному совпадению слов.</target>
            </trans-unit>
            <trans-unit id="search.pagination.label">
                <source>Result pages</source>
                <target>Страницы результатов</target>
            </trans-unit>
            <trans-unit id="search.pagination.previous">
                <source>Previous</source>
                <target>Назад</target>
            </trans-unit>
            <trans-unit id="search.pagination.next">
                <source>Next</source>
                <target>Далее</target>
            </trans-unit>
            <trans-unit id="search.pagination.position">
                <source>Page %d of %d</source>
                <target>Страница %d из %d</target>
            </trans-unit>
            <trans-unit id="search.loading">
                <source>Loading…</source>
                <target>Загрузка…</target>
            </trans-unit>
            <trans-unit id="search.recovery.applied" resname="search.recovery.applied">
                <source>No exact match for "%1$s" — showing results for "%2$s".</source>
                <target>Точных совпадений для «%1$s» нет — показаны результаты для «%2$s».</target>
            </trans-unit>
            <trans-unit id="search.recovery.suggestions" resname="search.recovery.suggestions">
                <source>Did you mean:</source>
                <target>Возможно, Вы имели в виду:</target>
            </trans-unit>
            <trans-unit id="search.recovery.kind.corrected" resname="search.recovery.kind.corrected">
                <source>Spelling corrected to the word used in the content</source>
                <target>Написание исправлено по слову из содержимого</target>
            </trans-unit>
            <trans-unit id="search.recovery.kind.split" resname="search.recovery.kind.split">
                <source>Compound split into separate words</source>
                <target>Составное слово разделено на отдельные слова</target>
            </trans-unit>
            <trans-unit id="search.recovery.kind.join" resname="search.recovery.kind.join">
                <source>Words joined into one compound</source>
                <target>Слова объединены в одно составное слово</target>
            </trans-unit>
            <trans-unit id="search.recovery.kind.dropped" resname="search.recovery.kind.dropped">
                <source>Terms that appear nowhere were left out</source>
                <target>Термины, которые нигде не встречаются, исключены</target>
            </trans-unit>
            <trans-unit id="search.recovery.kind.relaxed" resname="search.recovery.kind.relaxed">
                <source>Search relaxed: not every word has to match</source>
                <target>Поиск расширен: совпадение всех слов не обязательно</target>
            </trans-unit>
            <trans-unit id="search.recovery.chip.relaxed" resname="search.recovery.chip.relaxed">
                <source>Search without every word</source>
                <target>Искать без учёта всех слов</target>
            </trans-unit>
            <trans-unit id="chat.widget.newChat">
                <source>New conversation</source>
                <target>Новый диалог</target>
            </trans-unit>
            <trans-unit id="chat.widget.expand">
                <source>Expand</source>
                <target>Развернуть</target>
            </trans-unit>
            <trans-unit id="chat.widget.shrink">
                <source>Shrink</source>
                <target>Уменьшить</target>
            </trans-unit>
            <trans-unit id="chat.widget.close">
                <source>Close chat</source>
                <target>Закрыть чат</target>
            </trans-unit>
            <trans-unit id="chat.widget.closeTeaser">
                <source>Close notice</source>
                <target>Закрыть подсказку</target>
            </trans-unit>
            <trans-unit id="chat.widget.loading">
                <source>Loading …</source>
                <target>Загрузка …</target>
            </trans-unit>
            <trans-unit id="chat.widget.error">
                <source>The chat could not be loaded.</source>
                <target>Не удалось загрузить чат.</target>
            </trans-unit>
            <trans-unit id="chat.widget.send">
                <source>Send question</source>
                <target>Отправить вопрос</target>
            </trans-unit>
            <trans-unit id="rag.feedback.question">
                <source>Was this helpful?</source>
                <target>Был ли ответ полезен?</target>
            </trans-unit>
            <trans-unit id="rag.feedback.up">
                <source>Yes, helpful</source>
                <target>Да, полезен</target>
            </trans-unit>
            <trans-unit id="rag.feedback.down">
                <source>No, not helpful</source>
                <target>Нет, не полезен</target>
            </trans-unit>
            <trans-unit id="rag.feedback.thanks">
                <source>Thank you for your feedback.</source>
                <target>Спасибо за Ваш отзыв.</target>
            </trans-unit>
            <trans-unit id="rag.feedback.support">
                <source>Contact support</source>
                <target>Связаться с поддержкой</target>
            </trans-unit>
            <trans-unit id="rag.protection.rateLimited">
                <source>You have asked a lot of questions in a short time. Please try again in a few minutes.</source>
                <target>Вы задали слишком много вопросов за короткое время. Пожалуйста, повторите попытку через несколько минут.</target>
            </trans-unit>
            <trans-unit id="rag.protection.unavailable">
                <source>The assistant is not available at the moment. Please try again later or contact our support.</source>
                <target>Ассистент сейчас недоступен. Пожалуйста, повторите попытку позже или обратитесь в нашу службу поддержки.</target>
            </trans-unit>
            <trans-unit id="rag.protection.tooLong">
                <source>Your question is too long. Please keep it shorter (at most %d characters).</source>
                <target>Ваш вопрос слишком длинный. Пожалуйста, сократите его (не более %d символов).</target>
            </trans-unit>
        </body>
    </file>
