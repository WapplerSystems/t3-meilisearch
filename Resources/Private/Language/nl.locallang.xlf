                <target>Grootste bestand eerst</target>
            </trans-unit>
            <trans-unit id="search.sort.fileSize.asc">
                <source>Smallest file first</source>
                <target>Kleinste bestand eerst</target>
            </trans-unit>
            <trans-unit id="search.hybrid.label">
                <source>Semantic search</source>
                <target>Semantisch zoeken</target>
            </trans-unit>
            <trans-unit id="search.hybrid.help">
                <source>Combine keyword and vector matching for fuzzy-meaning queries.</source>
                <target>Combineert zoeken op trefwoorden en vectoren, zodat u op betekenis vindt in plaats van op exacte woorden.</target>
            </trans-unit>
