plugin.tx_wsmeilisearch_search {
    view {
        templateRootPaths {
            10 = EXT:ws_meilisearch/Resources/Private/Templates/
        }
        partialRootPaths {
            10 = EXT:ws_meilisearch/Resources/Private/Partials/
        }
        layoutRootPaths {
            10 = EXT:ws_meilisearch/Resources/Private/Layouts/
        }
    }

    settings {
        meilisearch {
            url = {$meilisearch.url}
            apiKey = {$meilisearch.apiKey}
            indexPrefix = {$meilisearch.indexPrefix}
        }

        # perPage and facets are read from Site Settings by default
        # (meilisearch.frontend.perPage / meilisearch.facets, see
        # settings.definitions.yaml + settings.yaml in this Set).
        #
        # Per-plugin TypoScript override is still honored — set
        # `settings.perPage = …` or `settings.facets = type,language`
        # here to scope the value to one plugin instance.
    }
}

# --- Live-suggest auto-attach --------------------------------------------
# When meilisearch.suggest.autoAttachInputSelector is set, ship the
# suggest dropdown JS globally and emit a <meta> tag carrying the CSS
# selector + endpoint URL. The JS reads the meta on DOMContentLoaded
# and promotes every matching input into a [data-ws-meilisearch-suggest]
# wrapper so the existing init() path attaches without code changes.
# Intended for layout-level search fields (header bar, off-canvas
# menu) that are NOT rendered by the ws_meilisearch Fluid template.
#
# Why a meta tag and not inline JS: CSP-strict templates strip
# unsigned inline <script> blocks; a meta carrying static attributes
# survives that policy and is the standard TYPO3 v14 channel for
# template-driven JS config.
[{$meilisearch.suggest.autoAttachInputSelector} != '']
    page.headerData.1746000010 = TEXT
    page.headerData.1746000010.value = <meta name="ws-meilisearch-suggest" data-endpoint="/_ws_meilisearch/suggest" data-input-selector="{$meilisearch.suggest.autoAttachInputSelector}" />
    page.includeJSFooter.wsMeilisearchSuggest = EXT:ws_meilisearch/Resources/Public/JavaScript/Frontend/suggest.js
    page.includeJSFooter.wsMeilisearchSuggest.defer = 1
[END]

# --- RAG floating chat widget --------------------------------------------
# Site-setting–driven opt-in. When enabled, every FE page that includes
# this Set gets a fixed bubble bottom-right that opens the RAG plugin
# in a slide-up panel.
#
# Target URL strategy:
#   1) chatWidget.pageUid > 0  → resolved via TypoLink at render time, so
#      the link follows the active language overlay (DE→/de/…, EN→/en/…)
#      and survives slug renames.
#   2) chatWidget.pageUid == 0 → fallback to the legacy hardcoded
#      chatWidget.url string for backward compatibility.
[{$meilisearch.rag.chatWidget.enabled} == 1]
    page.includeJSFooter.wsMeilisearchChatWidget = EXT:ws_meilisearch/Resources/Public/JavaScript/ChatWidget.js
    page.includeCSS.wsMeilisearchChatWidget = EXT:ws_meilisearch/Resources/Public/CSS/ChatWidget.css
[END]

# Render the bubble markup with a TypoLink-resolved URL when a pageUid
# is configured. Two condition branches so we evaluate the URL source
# exactly once per request.
[{$meilisearch.rag.chatWidget.enabled} == 1 && {$meilisearch.rag.chatWidget.pageUid} > 0]
    page.footerData.1746000000 = TEXT
    page.footerData.1746000000.typolink.parameter = {$meilisearch.rag.chatWidget.pageUid}
    page.footerData.1746000000.typolink.returnLast = url
    page.footerData.1746000000.wrap = <div id="ws-meilisearch-chat-widget" data-url="|" data-label="{$meilisearch.rag.chatWidget.label}"></div>
[END]

[{$meilisearch.rag.chatWidget.enabled} == 1 && {$meilisearch.rag.chatWidget.pageUid} == 0]
    page.footerData.1746000000 = TEXT
    page.footerData.1746000000.value (
<div id="ws-meilisearch-chat-widget" data-url="{$meilisearch.rag.chatWidget.url}" data-label="{$meilisearch.rag.chatWidget.label}"></div>
    )
[END]