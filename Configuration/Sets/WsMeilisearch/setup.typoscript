plugin.tx_wsmeilisearch_search {
    view {
        templateRootPaths {
            10 = EXT:ws_meilisearch/Resources/Private/Templates/
        }
        partialRootPaths {
            10 = EXT:ws_meilisearch/Resources/Private/Partials/
        }
        layoutRootPaths {
            10 = EXT:ws_meilisearch/Resources/Private/Layouts/
        }
    }

    settings {
        meilisearch {
            url = {$meilisearch.url}
            apiKey = {$meilisearch.apiKey}
            indexPrefix = {$meilisearch.indexPrefix}
        }

        # perPage and facets are read from Site Settings by default
        # (meilisearch.frontend.perPage / meilisearch.facets, see
        # settings.definitions.yaml + settings.yaml in this Set).
        #
        # Per-plugin TypoScript override is still honored — set
        # `settings.perPage = …` or `settings.facets = type,language`
        # here to scope the value to one plugin instance.
    }
}

# --- Live-suggest auto-attach --------------------------------------------
# When meilisearch.suggest.autoAttachInputSelector is set, ship the
# suggest dropdown JS globally and emit a <meta> tag carrying the CSS
# selector + endpoint URL. The JS reads the meta on DOMContentLoaded
# and promotes every matching input into a [data-ws-meilisearch-suggest]
# wrapper so the existing init() path attaches without code changes.
# Intended for layout-level search fields (header bar, off-canvas
# menu) that are NOT rendered by the ws_meilisearch Fluid template.
#
# Why a meta tag and not inline JS: CSP-strict templates strip
# unsigned inline <script> blocks; a meta carrying static attributes
# survives that policy and is the standard TYPO3 v14 channel for
# template-driven JS config.
[site("settings").get("meilisearch.suggest.autoAttachInputSelector")]
    page.headerData.1746000010 = TEXT
    page.headerData.1746000010.value = <meta name="ws-meilisearch-suggest" data-endpoint="/_ws_meilisearch/suggest" data-input-selector="{$meilisearch.suggest.autoAttachInputSelector}" />
    page.includeJSFooter.wsMeilisearchSuggest = EXT:ws_meilisearch/Resources/Public/JavaScript/Frontend/suggest.js
    page.includeJSFooter.wsMeilisearchSuggest.defer = 1
[END]

# --- RAG floating chat widget --------------------------------------------
# Site-setting-driven opt-in: a fixed bubble bottom-right opens the RAG
# plugin in a slide-up panel.
#
# Scope: by default EVERY FE page that includes this Set gets the bubble.
# Two independent gates narrow that down. Each is inert at its default 0,
# and a page must pass every active gate:
#   1) chatWidget.restrictToPageUid    -> exactly that page, subpages excluded
#   2) chatWidget.restrictToSubtreeUid -> that page plus everything below it
# Set both only when you want the intersection; normally one is enough.
#
# The scope lives in the condition rather than in PHP because a condition
# verdict is part of the page-cache identifier: per-page differences cache
# correctly and cost nothing per request. Two caveats behind the shape of
# this block:
#   * TypoScript conditions do NOT nest - a `[...]` line implicitly closes
#     the previous one - so the gates are one combined expression instead of
#     an outer wrapper, and assets + markup share a single condition.
#   * `page` is populated only in a frontend request; in CLI/BE the uid gate
#     evaluates to false, which is the safe direction (no bubble, no error).
[site("settings").get("meilisearch.rag.chatWidget.enabled") && ({$meilisearch.rag.chatWidget.restrictToPageUid} == 0 || page["uid"] == {$meilisearch.rag.chatWidget.restrictToPageUid}) && ({$meilisearch.rag.chatWidget.restrictToSubtreeUid} == 0 || {$meilisearch.rag.chatWidget.restrictToSubtreeUid} in tree.rootLineIds)]
    page.includeJSFooter.wsMeilisearchChatWidget = EXT:ws_meilisearch/Resources/Public/JavaScript/ChatWidget.js
    # Inline chat (no iframe): the widget injects the RAG shell into the host
    # DOM, so RagStream.js (driver) and RagEmbed.css (scoped look) must load on
    # the host page too.
    page.includeJSFooter.wsMeilisearchRagStream = EXT:ws_meilisearch/Resources/Public/JavaScript/RagStream.js
    page.includeCSS.wsMeilisearchChatWidget = EXT:ws_meilisearch/Resources/Public/CSS/ChatWidget.css
    page.includeCSS.wsMeilisearchRagEmbed = EXT:ws_meilisearch/Resources/Public/CSS/RagEmbed.css
    # Answer component styles: the panel injects the shell into the host DOM,
    # so the embed document's own <f:asset.css> never travels along.
    page.includeCSS.wsMeilisearchRag = EXT:ws_meilisearch/Resources/Public/CSS/Rag.css

    # Anchor of the widget. ChatWidgetRenderer resolves the target URL
    # (chatWidget.pageUid via TypoLink, so it follows the language and slug
    # renames; else the legacy chatWidget.url) and hands the branding — name,
    # icon, texts, greeting, example questions — to ChatWidget.js as JSON.
    page.footerData.1746000000 = USER
    page.footerData.1746000000 {
        userFunc = WapplerSystems\Meilisearch\Frontend\ChatWidgetRenderer->render
        pageUid = {$meilisearch.rag.chatWidget.pageUid}
        url = {$meilisearch.rag.chatWidget.url}
        embedTypeNum = {$meilisearch.rag.chatWidget.embedTypeNum}
    }
[END]

# --- Bare RAG chat embed page type ---------------------------------------
# Dedicated typeNum the chat-widget iframe loads. Independent PAGE object
# (does NOT inherit the site's `page` template), so it renders a minimal
# self-contained document containing ONLY the wsmeilisearch_rag plugin —
# no header/nav/footer. Styled by RagEmbed.css; the plugin's own JS/CSS
# assets are emitted via the normal asset collector. RagController keeps
# this type sticky across the plugin's GET form submit + action links.
wsMeilisearchRagEmbed = PAGE
wsMeilisearchRagEmbed {
    typeNum = {$meilisearch.rag.chatWidget.embedTypeNum}
    config {
        disableAllHeaderCode = 0
        admPanel = 0
        no_cache = 1
        additionalHeaders.10.header = X-Robots-Tag: noindex, nofollow
    }
    bodyTag = <body class="ws-meilisearch-rag-embed">
    includeCSS.ragEmbed = EXT:ws_meilisearch/Resources/Public/CSS/RagEmbed.css
    10 = CONTENT
    10 {
        table = tt_content
        select {
            pidInList = this
            orderBy = sorting
            where = CType = 'wsmeilisearch_rag'
        }
    }
}